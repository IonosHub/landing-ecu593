# Copia este archivo a .env y completa los valores.

# URL pública de la landing (canonical y Open Graph). Ej: https://ecu593.com
PUBLIC_SITE_URL=

# Webhook de n8n que recibe el formulario y avisa por correo a ecu593english@gmail.com.
# Si se deja vacío se usa el de src/config/site.ts.
PUBLIC_LEAD_WEBHOOK_URL=https://n8n.ionoshub.net/webhook/correos-ecu593

# Número de WhatsApp en formato internacional, sin "+".
PUBLIC_WHATSAPP_NUMBER=593963660675

# true = mostrar los "Dato pendiente" también en el build (útil para revisión con el cliente)
PUBLIC_SHOW_PENDING=false
