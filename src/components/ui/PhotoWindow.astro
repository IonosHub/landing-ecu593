---
import type { ImageRef } from '../../data/types';
import { useDictionary } from '../../i18n';
import { showPending } from '../../lib/pending';

/** Die-cut passport photo window. Without a photo it shows what shot belongs here. */
interface Props {
  image: ImageRef;
  ratio?: string;
  class?: string;
}

const { image, ratio = '4 / 5', class: className } = Astro.props;
const t = useDictionary(Astro.currentLocale);
---

<figure class:list={['window', className]} style={`--ratio:${ratio}`} data-anim="window">
  {
    image.src ? (
      <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
    ) : (
      <div class="empty" role="img" aria-label={image.alt}>
        {showPending && (
          <>
            <span class="data-label">{t.photo.pending}</span>
            <span class="brief">{image.brief}</span>
          </>
        )}
      </div>
    )
  }
</figure>

<style>
  .window {
    margin: 0;
    position: relative;
    aspect-ratio: var(--ratio);
    padding: 11px;
    border-radius: 10px;
    background:
      var(--rosette-paper) center / 140% no-repeat,
      var(--paper-deep);
    box-shadow: inset 0 0 0 1px var(--paper-edge);
  }
  img,
  .empty {
    width: 100%;
    height: 100%;
    border-radius: 6px;
  }
  img {
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04);
  }
  .empty {
    display: grid;
    place-content: center;
    gap: var(--space-2);
    padding: var(--space-5);
    text-align: center;
    background:
      repeating-linear-gradient(-45deg, transparent 0 9px, rgb(19 33 63 / 0.05) 9px 10px),
      rgb(230 240 236 / 0.82);
    border: 1.5px dashed var(--rule);
  }
  .brief {
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 24ch;
  }
</style>
