---
import { useDictionary } from '../../i18n';
import { isPending, showPending } from '../../lib/pending';
import { buildWhatsAppUrl } from '../../lib/whatsapp';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Value from '../ui/Value.astro';

const t = useDictionary(Astro.currentLocale);
const copy = t.faq;
const visible = copy.items.filter((faq) => showPending || !isPending(faq.answer));
---

<section class="faq paper" aria-labelledby="preguntas">
  <div class="container layout">
    <div>
      <SectionHeading id="preguntas" title={copy.title} />
      <p class="more">
        {copy.more} <a href={buildWhatsAppUrl(copy.whatsappMessage)} target="_blank" rel="noopener">{copy.moreLink}</a>.
      </p>
    </div>
    <div class="items">
      {
        visible.map((faq) => (
          <details name="faq">
            <summary>
              {faq.question}
              <Icon name="plus" size={22} class="toggle" />
            </summary>
            <p>
              <Value value={faq.answer} />
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--space-9);
  }
  .layout {
    display: grid;
    grid-template-columns: 0.9fr 1.3fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .more {
    margin-top: var(--space-5);
    color: var(--ink-soft);
  }
  .more a {
    color: var(--sky-text);
    font-weight: 600;
  }
  .items {
    border-top: 2px solid var(--navy-900);
  }
  details {
    border-bottom: 1.5px solid var(--rule);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-stretch: 100%;
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--navy-900);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(.toggle) {
    flex: none;
    color: var(--flame);
    transition: transform var(--dur-base) var(--ease-out);
  }
  details[open] summary :global(.toggle) {
    transform: rotate(45deg);
  }
  summary:hover {
    color: var(--sky-text);
  }
  details p {
    padding-bottom: var(--space-5);
    max-width: 60ch;
    color: var(--ink-soft);
  }
  details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--dur-base) var(--ease-out),
      content-visibility var(--dur-base) allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
  @supports (interpolate-size: allow-keywords) {
    .items {
      interpolate-size: allow-keywords;
    }
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
