---
import { site } from '../../config/site';
import { LEVEL_COUNT, WEEKS_PER_LEVEL } from '../../data/method';
import { buildWhatsAppUrl } from '../../lib/whatsapp';
import Button from '../ui/Button.astro';
import Mrz from '../ui/Mrz.astro';
import Stamp from '../ui/Stamp.astro';

const fields = [
  { es: 'Titular', en: 'Holder', value: 'Tú' },
  { es: 'Destino', en: 'Destination', value: 'Inglés' },
  { es: 'Programas', en: 'Programs', value: 'Kids · Teens · Adultos' },
  { es: 'Niveles', en: 'Levels', value: `${LEVEL_COUNT} × ${WEEKS_PER_LEVEL} semanas` },
  { es: 'Modalidad', en: 'Mode', value: 'Presencial · Online' },
  { es: 'Nota para aprobar', en: 'Pass mark', value: '7 / 10' },
];
---

<section class="cover" id="top" aria-labelledby="hero-title">
  <div class="container spread">
    <div class="page page-pitch">
      <h1 id="hero-title">Aprende inglés, un sello a la vez.</h1>
      <p class="sub">
        Cursos de inglés para niños, adolescentes y adultos, presenciales u online. Son {LEVEL_COUNT} niveles de {WEEKS_PER_LEVEL} semanas, y cada nivel que apruebas es un sello más en tu pasaporte.
      </p>
      <div class="actions">
        <Button href="#solicitud">Quiero inscribirme</Button>
        <Button href={buildWhatsAppUrl()} variant="whatsapp" external>Escríbenos</Button>
      </div>
      <Stamp class="stamp-a" top="Learn · Grow · Achieve" main="593" bottom="Ecu593 English" ink="flame" rotate={-12} size="clamp(7rem, 12vw, 10rem)" />
    </div>

    <div class="page page-data" aria-label="Pasaporte de estudiante Ecu593 English">
      <div class="doc-head">
        <span>Pasaporte de estudiante</span>
        <span class="en">Student passport</span>
      </div>
      <div class="doc-body">
        <div class="photo">
          <img src={site.logo.src} width={site.logo.width} height={site.logo.height} alt={`Logo de ${site.name}`} />
        </div>
        <dl class="fields">
          <div class="row-3">
            <div><dt class="data-label">Tipo / Type</dt><dd>P</dd></div>
            <div><dt class="data-label">Código / Code</dt><dd>ECU593</dd></div>
            <div><dt class="data-label">N.º / No.</dt><dd class="tabular">L-01</dd></div>
          </div>
          {
            fields.map((field) => (
              <div>
                <dt class="data-label">
                  {field.es} / {field.en}
                </dt>
                <dd>{field.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <Mrz lines={['P<ECU593<<ENGLISH<<LEARN<GROW<ACHIEVE', 'TU<<NIVEL01<<12X4<SEMANAS<<APRUEBA<7<10']} class="doc-mrz" />
      <Stamp class="stamp-b" shape="rect" top="Entrada" main="Nivel 01" bottom="Semana 1" ink="sky" rotate={7} size="clamp(9rem, 14vw, 11.5rem)" />
      <Stamp class="stamp-c" top="Presencial · Online" main="ECU" bottom="Ecuador · 593" ink="violet" rotate={16} size="clamp(6rem, 9vw, 7.5rem)" />
    </div>
  </div>
</section>

<style>
  .cover {
    position: relative;
    overflow: clip;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(3rem, 2rem + 5vw, 6rem);
    background:
      var(--rosette-cover) right -18rem top -14rem / 56rem no-repeat,
      var(--rosette-cover) left -22rem bottom -26rem / 48rem no-repeat,
      radial-gradient(120% 90% at 50% 0%, var(--navy-800), var(--navy-900) 60%, var(--navy-950));
    color: var(--on-navy);
    perspective: 2200px;
  }

  .spread {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: var(--radius-page);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.7), 0 2px 0 rgb(0 0 0 / 0.2);
  }

  .page {
    position: relative;
    padding: clamp(1.5rem, 1rem + 2.4vw, 3.25rem);
    background-color: var(--paper);
    background-image: var(--guilloche-band);
    background-size: 240px 96px;
    color: var(--ink);
  }

  /* Pitch is the right-hand page on desktop, first on mobile. */
  .page-pitch {
    order: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-5);
    border-radius: 0 var(--radius-page) var(--radius-page) 0;
    box-shadow: inset 28px 0 32px -26px rgb(11 19 48 / 0.45);
  }
  .page-data {
    order: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    border-radius: var(--radius-page) 0 0 var(--radius-page);
    background-image: var(--rosette-paper), var(--guilloche-band);
    background-size: 34rem, 240px 96px;
    background-position: 60% 40%, 0 0;
    background-repeat: no-repeat, repeat;
    box-shadow: inset -28px 0 32px -26px rgb(11 19 48 / 0.45);
    transform-origin: right center;
  }

  h1 {
    font-size: var(--step-4);
    max-width: 11ch;
    color: var(--navy-900);
  }
  .sub {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    position: relative;
    z-index: 2;
  }

  .doc-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1.5px solid var(--rule);
    font-family: var(--font-display);
    font-stretch: 87%;
    font-weight: 750;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy-800);
  }
  .doc-head .en {
    color: var(--ink-soft);
    font-weight: 500;
  }
  .doc-body {
    display: grid;
    grid-template-columns: minmax(7rem, 0.8fr) 1.6fr;
    gap: clamp(1rem, 0.6rem + 1.4vw, 2rem);
    align-items: start;
  }
  .photo {
    padding: 6px;
    border-radius: 10px;
    background: var(--paper-deep);
    box-shadow: inset 0 0 0 1px var(--paper-edge);
  }
  .photo img {
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .fields {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .fields dd {
    margin: 2px 0 0;
    font-family: var(--font-display);
    font-stretch: 100%;
    font-weight: 700;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.125rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .row-3 {
    display: grid;
    grid-template-columns: auto auto auto;
    justify-content: start;
    gap: var(--space-5);
  }
  .doc-mrz {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1.5px solid var(--rule);
  }

  .page :global(.stamp-a) {
    position: absolute;
    right: 4%;
    top: 5%;
  }
  .page :global(.stamp-b) {
    position: absolute;
    right: 5%;
    bottom: 5%;
  }
  .page :global(.stamp-c) {
    position: absolute;
    right: 5%;
    top: 36%;
  }
  .page :global(.stamp-a) { --stamp-delay: 750ms; }
  .page :global(.stamp-b) { --stamp-delay: 1050ms; }
  .page :global(.stamp-c) { --stamp-delay: 1350ms; }

  /* Opening: the data page swings open from the gutter, then the stamps land. */
  :global(.motion-ok) .page-data {
    animation: open-page 1100ms var(--ease-out) both;
  }
  :global(.motion-ok) .page-pitch > :not(:global(.stamp)) {
    animation: rise 900ms var(--ease-out) both;
    animation-delay: 250ms;
  }
  @keyframes open-page {
    from {
      transform: rotateY(-70deg);
      opacity: 0.4;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(6px);
    }
  }

  @media (max-width: 900px) {
    .spread {
      grid-template-columns: 1fr;
    }
    .page-pitch {
      order: 1;
      border-radius: var(--radius-page) var(--radius-page) 0 0;
      box-shadow: inset 0 -28px 32px -28px rgb(11 19 48 / 0.4);
    }
    .page-data {
      order: 2;
      border-radius: 0 0 var(--radius-page) var(--radius-page);
      box-shadow: inset 0 28px 32px -28px rgb(11 19 48 / 0.4);
      transform-origin: center top;
    }
    .page :global(.stamp-a) {
      top: 0.5rem;
      right: 0.5rem;
      --size: 5.5rem !important;
    }
    .page :global(.stamp-b) {
      bottom: 0.5rem;
      right: 0.75rem;
    }
    @keyframes open-page {
      from {
        transform: rotateX(60deg);
        opacity: 0.4;
      }
    }
  }
  @media (max-width: 520px) {
    .doc-body {
      grid-template-columns: 6.5rem 1fr;
    }
    .row-3 {
      grid-template-columns: auto auto;
    }
    .row-3 > :last-child {
      display: none;
    }
    .page :global(.stamp-c) {
      right: 0.75rem;
      top: 0.25rem;
    }
  }
</style>
