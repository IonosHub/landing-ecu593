---
import { testimonials } from '../../data/testimonials';
import { showPending } from '../../lib/pending';
import PhotoWindow from '../ui/PhotoWindow.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const hasContent = testimonials.length > 0;
---

{
  (hasContent || showPending) && (
    <section class="testimonials paper" aria-labelledby="historias">
      <div class="container">
        <SectionHeading id="historias" title="Historias de quienes ya tienen sellos" />
        {hasContent ? (
          <ul class="quotes">
            {testimonials.map((item) => (
              <li class="quote">
                {item.image && <PhotoWindow image={item.image} ratio="1 / 1" class="quote-photo" />}
                <blockquote>
                  <p>“{item.quote}”</p>
                  <footer>
                    <strong>{item.name}</strong>
                    <span class="data-label">{item.role}</span>
                  </footer>
                </blockquote>
              </li>
            ))}
          </ul>
        ) : (
          <p class="slot">
            <span class="data-label">Dato pendiente</span>
            <span>
              Agrega testimonios reales (con permiso) en <code>src/data/testimonials.ts</code>. Mientras la lista esté vacía, esta sección no se publica.
            </span>
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  .testimonials {
    padding-block: var(--space-9);
  }
  .quotes {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-6);
  }
  .quote {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .quote :global(.quote-photo) {
    width: 6rem;
  }
  blockquote {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  blockquote p {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.4;
  }
  footer {
    display: grid;
  }
  .slot {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding: var(--space-6);
    border: 1.5px dashed var(--flame);
    border-radius: var(--radius-page);
    color: var(--flame-text);
    max-width: 44rem;
  }
  .slot .data-label {
    color: var(--flame-text);
  }
</style>
