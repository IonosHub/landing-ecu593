---
import { useDictionary } from '../../i18n';
import { isPending, showPending } from '../../lib/pending';
import SectionHeading from '../ui/SectionHeading.astro';
import Value from '../ui/Value.astro';

const t = useDictionary(Astro.currentLocale);
const copy = t.endorsements;
// Pending endorsements only appear while there is someone to fill them in.
const visible = copy.items.filter((item) => showPending || !isPending(item.body));
---

<section class="endorsements" aria-labelledby="incluye">
  <div class="container">
    <SectionHeading id="incluye" tone="navy" title={copy.title} lead={copy.lead} />
    <dl class="list">
      {
        visible.map((item) => (
          <div class="row" data-anim="row">
            <dt>{item.title}</dt>
            <dd>
              <Value value={item.body} />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .endorsements {
    padding-block: var(--space-9);
    background:
      var(--rosette-cover) right -20rem center / 50rem no-repeat,
      var(--navy-900);
    color: var(--on-navy);
  }
  .list {
    margin: var(--space-8) 0 0;
    border-top: 1.5px solid rgb(185 196 226 / 0.25);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) 1.6fr;
    gap: var(--space-3) var(--space-7);
    padding-block: var(--space-6);
    border-bottom: 1.5px solid rgb(185 196 226 / 0.25);
  }
  dt {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--sun);
  }
  dd {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--on-navy-soft);
    max-width: 40rem;
  }
  dd :global(.pending) {
    color: #ffb4ae;
    border-color: #ff8a80;
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
