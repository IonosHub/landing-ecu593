---
import { site } from '../../config/site';
import { isPending, showPending } from '../../lib/pending';
import { buildWhatsAppUrl } from '../../lib/whatsapp';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Value from '../ui/Value.astro';

const socials = site.social.filter((link) => showPending || !isPending(link.url));
const year = new Date().getFullYear();
---

<footer class="back-cover">
  <div class="container">
    <div class="closing">
      <h2>¿Listo para tu primer sello?</h2>
      <div class="actions">
        <Button href="#solicitud">Quiero inscribirme</Button>
        <Button href={buildWhatsAppUrl()} variant="whatsapp" external>Escríbenos</Button>
      </div>
    </div>

    <div class="columns">
      <div class="brand">
        <img src={site.logo.src} width={site.logo.width} height={site.logo.height} alt={site.name} loading="lazy" />
        <p class="slogan">{site.slogan.join(' • ')}</p>
      </div>

      <div>
        <h3 class="data-label">Contacto</h3>
        <ul>
          <li>
            <Icon name="whatsapp" size={18} />
            <a href={buildWhatsAppUrl()} target="_blank" rel="noopener">WhatsApp {site.whatsapp.display}</a>
          </li>
          {(showPending || !isPending(site.email)) && (
            <li>
              <Icon name="mail" size={18} />
              {isPending(site.email) ? <Value value={site.email} /> : <a href={`mailto:${site.email}`}>{site.email}</a>}
            </li>
          )}
          {(showPending || !isPending(site.address)) && (
            <li>
              <Icon name="pin" size={18} />
              <span>
                <Value value={site.address} />
                {(showPending || (!isPending(site.address) && !isPending(site.city))) && ', '}
                <Value value={site.city} />
              </span>
            </li>
          )}
          {(showPending || !isPending(site.officeHours)) && (
            <li>
              <Icon name="clock" size={18} />
              <Value value={site.officeHours} />
            </li>
          )}
        </ul>
      </div>

      {socials.length > 0 && (
        <div>
          <h3 class="data-label">Redes</h3>
          <ul>
            {socials.map((link) => (
              <li>{isPending(link.url) ? <Value value={link.url} /> : <a href={link.url} target="_blank" rel="noopener">{link.name}</a>}</li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <p class="legal">© {year} {site.legalName}. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .back-cover {
    padding-block: var(--space-9) var(--space-6);
    background:
      var(--rosette-cover) left -16rem top -18rem / 52rem no-repeat,
      radial-gradient(120% 90% at 50% 100%, var(--navy-800), var(--navy-900) 55%, var(--navy-950));
    color: var(--on-navy);
  }
  .closing {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    text-align: center;
    padding-bottom: var(--space-9);
  }
  h2 {
    font-size: var(--step-4);
    max-width: 14ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  .columns {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: var(--space-7);
    padding-block: var(--space-7);
    border-top: 1.5px solid rgb(185 196 226 / 0.2);
  }
  .brand {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .brand img {
    width: 7.5rem;
    height: auto;
    border-radius: 10px;
    background: #fff;
    padding: 4px;
  }
  .slogan {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sun);
  }
  h3 {
    margin-bottom: var(--space-4);
    color: var(--on-navy-soft);
    font-stretch: 100%;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--on-navy-soft);
  }
  li :global(svg) {
    flex: none;
    color: var(--sun);
  }
  li a {
    color: var(--on-navy);
  }
  li :global(.pending) {
    color: #ffb4ae;
    border-color: #ff8a80;
  }
  .legal {
    padding-top: var(--space-5);
    border-top: 1.5px solid rgb(185 196 226 / 0.2);
    font-size: var(--step--1);
    color: var(--on-navy-soft);
  }

  @media (max-width: 760px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
