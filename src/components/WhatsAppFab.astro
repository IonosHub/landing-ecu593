---
import { buildWhatsAppUrl } from '../lib/whatsapp';
import Icon from './ui/Icon.astro';
---

<a class="fab" href={buildWhatsAppUrl()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <Icon name="whatsapp" size={26} />
  <span class="label">¿Dudas? Escríbenos</span>
</a>

<style>
  .fab {
    position: fixed;
    right: clamp(1rem, 2vw, 1.75rem);
    bottom: clamp(1rem, 2vw, 1.75rem);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    background: var(--whatsapp);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 10px rgb(11 19 48 / 0.25), 0 18px 32px -14px rgb(11 19 48 / 0.6);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .fab:hover {
    transform: translateY(-3px);
  }
  :global(.motion-ok) .fab {
    animation: fab-in 700ms var(--ease-out) 1.6s both;
  }
  @keyframes fab-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.9);
    }
  }
  @media (max-width: 640px) {
    .fab {
      width: 3.5rem;
      padding: 0;
      justify-content: center;
    }
    .label {
      display: none;
    }
  }
</style>
