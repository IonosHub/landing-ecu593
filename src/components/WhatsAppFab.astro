---
import { useDictionary } from '../i18n';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import Icon from './ui/Icon.astro';

const t = useDictionary(Astro.currentLocale);
---

<a class="fab" href={buildWhatsAppUrl(t.whatsapp.greeting)} target="_blank" rel="noopener" aria-label={t.whatsapp.fabLabel} data-fab>
  <Icon name="whatsapp" size={26} />
  <span class="label">{t.whatsapp.fab}</span>
</a>

<style>
  .fab {
    position: fixed;
    right: clamp(1rem, 2vw, 1.75rem);
    bottom: clamp(1rem, 2vw, 1.75rem);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    background: var(--whatsapp);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 10px rgb(11 19 48 / 0.25), 0 18px 32px -14px rgb(11 19 48 / 0.6);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .fab:hover {
    transform: translateY(-3px);
  }
  @media (max-width: 640px) {
    .fab {
      width: 3.5rem;
      padding: 0;
      justify-content: center;
    }
    .label {
      display: none;
    }
  }
</style>
